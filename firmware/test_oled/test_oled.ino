/*
 * ===============================================================================
 *  AgriStack — Standalone SSD1306 OLED (128x64) I2C Hardware Tester
 * ===============================================================================
 *  Zero external libraries needed! Uses ONLY built-in <Wire.h>.
 *
 *  ESP32 Pin Connections:
 *   - GND -> GND
 *   - VCC -> 3.3V (or 5V)
 *   - SDA -> GPIO 21
 *   - SCL -> GPIO 22
 * ===============================================================================
 */


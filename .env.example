ESP32_HOST=your_esp32_ip_here
VITE_ESP32_IP=http://your_esp32_ip_here
VITE_ESP32_HOST=your_esp32_ip_here
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ==========================================
# EXTERNAL API CREDENTIALS & SERVICE ENDPOINTS
# ==========================================
COPERNICUS_CLIENT_ID=your_copernicus_client_id_here
COPERNICUS_CLIENT_SECRET=your_copernicus_client_secret_here
